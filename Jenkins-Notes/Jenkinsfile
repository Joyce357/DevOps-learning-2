pipeline {
    agent any

    environment {
        AWS_REGION      = 'ca-central-1'
        ECR_REGISTRY    = '891377304437.dkr.ecr.ca-central-1.amazonaws.com'
        ECR_REPOSITORY  = 'class10-repository'
    }

    stages {
        stage('Clone Github Repository') {
            steps {
                git branch: 'main', credentialsId: 'jenkins-github-authentication', url: 'https://github.com/CalsonNjinoh/DevOps.git'
            }
        }
        stage('Maven Build') {
            steps {
                dir('WebApplication-2') {
                    sh 'mvn test'
                    sh 'mvn compile'
                    sh 'mvn package'
                }
            }
        }
        stage('Determine App Version') {
            steps {
                dir('WebApplication-2') {
                    script {
                        env.APP_VERSION = sh(script: 'mvn help:evaluate -Dexpression=project.version -q -DforceStdout', returnStdout: true).trim()
                        echo "Application Version: ${env.APP_VERSION}"
                    }
                }
            }
        }
        stage('Sonarube Analysis') {
            steps {
                dir('WebApplication-2') {
                    withSonarQubeEnv(installationName: 'Sonarqube-server') {
                        sh 'mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar -Dsonar.java.binaries=target/classes'
                    }
                }
            }
        }
        stage('Quality Gate') {
            steps {
                timeout(time: 1, unit: 'HOURS') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }
        stage('Upload Artifacts to Nexus') {
            steps {
                script {
                    dir('WebApplication-2') {
                        // Construct the artifact path based on the version
                        def projectName = 'WebApplication'
                        def artifactPath = "target/${projectName}-${env.APP_VERSION}.war"
                        echo "Artifact Path: ${artifactPath}"
                        // Check if the artifact path exists
                        sh "if [ -f ${artifactPath} ]; then echo 'Artifact found'; else echo 'Artifact not found'; fi"

                        // Upload artifact to Nexus
                        nexusArtifactUploader(
                            nexusVersion: 'nexus3',
                            protocol: 'http',
                            nexusUrl: '16.54.231.9:8081',
                            groupId: 'com.example',
                            version:  env.APP_VERSION,
                            repository: 'class10-webapp-repository',
                            credentialsId: 'nexus-auth',
                            artifacts: [
                                [artifactId: 'WebApplication',
                                 classifier: '',
                                 file: artifactPath,
                                 type: 'war'],
                                [artifactId: 'WebApplication',
                                 classifier: '',
                                 file: 'pom.xml',
                                 type: 'pom']
                            ]
                        )
                    }
                }
            }
        }
        stage('Send message to Slack') {
            steps {
                echo 'Sending message to Slack channel'

                slackSend(
                    channel: '#jenkins-notifications',
                    message: 'Hi class10, your application deployment is now successful',
                    color: '#36a64f' // Optional: specify a color for the message
                )
            }
        }
        stage('Build & Push Docker ECR') {
            steps {
                script {
                    dir('WebApplication-2') {
                        withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-ecr-credentials']]) {
                            sh "aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${ECR_REGISTRY}"
                            sh "docker build -t ${ECR_REPOSITORY}:${APP_VERSION} ."
                            sh "docker tag ${ECR_REPOSITORY}:${APP_VERSION} ${ECR_REGISTRY}/${ECR_REPOSITORY}:${APP_VERSION}"
                            sh "docker tag ${ECR_REPOSITORY}:${APP_VERSION} ${ECR_REGISTRY}/${ECR_REPOSITORY}:latest"
                            sh "docker push ${ECR_REGISTRY}/${ECR_REPOSITORY}:${APP_VERSION}"
                            sh "docker push ${ECR_REGISTRY}/${ECR_REPOSITORY}:latest"
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            echo 'Pipeline execution is now completed'
        }
    }
}